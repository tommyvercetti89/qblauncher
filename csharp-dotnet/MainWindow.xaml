                                            </StackPanel>
                                        </DockPanel>
                                        <Border Background="{DynamicResource BgStageInner}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="11" Padding="14,11" Margin="0,14,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="HealthDot" Width="9" Height="9" Fill="{DynamicResource WarningColor}" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="HealthText" Text="Dinleyici duraklatıldı." FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Global Kısayol Kombinasyonu" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
