                                            </StackPanel>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="Hızlı Seçme Ekranı Görünümü" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                                <TextBlock Text="Kısayola basıldığında tam ekran buğulu cam üzerinde kare ızgara veya kompakt mini pencere kullanın." FontSize="14" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,0,0,14"/>
