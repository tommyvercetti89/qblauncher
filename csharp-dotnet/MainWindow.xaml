                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="Kısayollar" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox x:Name="ChkListenerConsent" DockPanel.Dock="Right" Style="{StaticResource YellowSwitch}" Checked="ListenerConsent_Changed" Unchecked="ListenerConsent_Changed"/>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="Kullanıcı Onayı &amp; Süresiz Dinleme" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
