                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="Akıcı Açılış Animasyonları" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                                <TextBlock Text="Mini seçme ekranı çağrıldığında yumuşak ölçeklenme ve saydamlık geçişi uygular." FontSize="14" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,0,0,14"/>
