                                            </StackPanel>
                                        </DockPanel>
                                        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,0,0,14"/>
                                        <DockPanel Margin="0,0,0,14">
                                            <CheckBox x:Name="ChkQuickNumbers" DockPanel.Dock="Right" Style="{StaticResource YellowSwitch}" Checked="BehaviorToggle_Changed" Unchecked="BehaviorToggle_Changed"/>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="Tek Tuşla Hızlı Başlatma (1-9)" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                                <TextBlock Text="Mini ekran açıkken arama kutusu boşsa 1-9 rakamlarına basarak anında çalıştırın." FontSize="14" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,0,0,14"/>
                                        <DockPanel Margin="0,0,0,14">
