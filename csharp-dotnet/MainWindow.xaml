                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="308"/>
                                </Grid.ColumnDefinitions>

                                <!-- COL 1: 1. Profil seçin -->
                                <DockPanel Grid.Column="0" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Text="1. Profil seçin" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                                    <TextBox x:Name="ProfileSearchBox" DockPanel.Dock="Top" Style="{StaticResource LargeInput}" TextChanged="ProfileSearch_TextChanged" Margin="0,0,0,12" ToolTip="Profil ara"/>
