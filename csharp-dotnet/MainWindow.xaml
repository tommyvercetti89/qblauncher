                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="Başlatma Sonrası Otomatik Gizle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
