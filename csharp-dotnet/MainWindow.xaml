                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="20,18">
                                        <StackPanel>
                                            <TextBlock Text="Kayıtlı Öğe" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="HomeItemCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="20,18">
                                        <StackPanel>
                                            <TextBlock Text="Aktif Kısayol" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="HomeHotkeyLabel" Text="Alt + Space" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="20,18">
                                        <StackPanel>
                                            <TextBlock Text="Dinleyici Durumu" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock x:Name="HomeListenerState" Text="Beklemede" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- TAB: GENEL -->
                        <ScrollViewer x:Name="TabGeneral" Visibility="Collapsed" Margin="26,26,26,22" VerticalScrollBarVisibility="Auto">
