                                            <TextBlock x:Name="ConfigPathText" Text="qblauncher-config.json" FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

