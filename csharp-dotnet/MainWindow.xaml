                                    </UniformGrid>

                                    <TextBox x:Name="PresetSearchBox" DockPanel.Dock="Top" Style="{StaticResource LargeInput}" TextChanged="PresetSearch_TextChanged" Margin="0,0,0,8" ToolTip="Ön ayarlarda ara"/>

                                    <WrapPanel x:Name="PresetChipsPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="Tümü" Tag="all" Click="PresetChip_Click" Style="{StaticResource YellowPillBtn}" Padding="7,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="Uygulama" Tag="app" Click="PresetChip_Click" Style="{StaticResource PillBtn}" Padding="7,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="Sistem" Tag="system" Click="PresetChip_Click" Style="{StaticResource PillBtn}" Padding="7,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="Dosya" Tag="file" Click="PresetChip_Click" Style="{StaticResource PillBtn}" Padding="7,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="Web" Tag="web" Click="PresetChip_Click" Style="{StaticResource PillBtn}" Padding="7,4" FontSize="12" Margin="0,0,0,4"/>
                                    </WrapPanel>

                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="10">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="PresetsPoolPanel"/>
                                        </ScrollViewer>
                                    </Border>
                                </DockPanel>
                            </Grid>
                        </Grid>

                        <!-- TAB: ANA SAYFA -->
                        <ScrollViewer x:Name="TabHome" Visibility="Collapsed" Margin="26,26,26,22" VerticalScrollBarVisibility="Auto">
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="Ana sayfa" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Hızlı Erişim Paneliniz Hazır" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
