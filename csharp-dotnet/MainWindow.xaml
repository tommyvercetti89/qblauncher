<Window x:Class="QBLauncherPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QBLauncher Pro"
        Width="1100"
        Height="650"
        MinWidth="420"
        MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Filee Dark Theme Brushes (Siyaha Dönük Gri) -->
        <SolidColorBrush x:Key="BgMain" Color="#121212"/>
        <SolidColorBrush x:Key="BgSidebar" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="BgCard" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BgStageInner" Color="#141414"/>
        <SolidColorBrush x:Key="BgPill" Color="#232323"/>
        <SolidColorBrush x:Key="BgPillHover" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="BgInput" Color="#141414"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#282828"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#383838"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7E7E7E"/>
        <SolidColorBrush x:Key="NavActiveBg" Color="#3A371C"/>
        <SolidColorBrush x:Key="NavActiveFg" Color="#FDE047"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FACC15"/>
        <SolidColorBrush x:Key="AccentYellowHover" Color="#FDE047"/>
        <SolidColorBrush x:Key="AccentYellowFg" Color="#111111"/>
        <SolidColorBrush x:Key="BadgeBg" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#22C55E"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="GlassTint" Color="#CC101114"/>
        <SolidColorBrush x:Key="GlassTileBg" Color="#EB1E1F23"/>
        <SolidColorBrush x:Key="GlassTileHoverBg" Color="#F52A2C32"/>

        <!-- Crisp ClearType & Layout Rounding Defaults -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Pill Secondary Button -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgPill}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}" RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgPillHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Yellow Primary Pill Button -->
        <Style x:Key="YellowPillBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentYellow}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentYellowFg}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentYellowHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Symmetrical Segmented Pill Switch Button -->
        <Style x:Key="SegPillBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Modern Scrollbar Style (Thin Rounded Pill, No Legacy Arrows) -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" Margin="1,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="thumbBd" Background="#48FFFFFF" CornerRadius="3" Width="5" HorizontalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBd" Property="Background" Value="{DynamicResource AccentYellow}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgPill}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Icon Button -->
        <Style x:Key="WinIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgPill}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Large Input Box -->
        <Style x:Key="LargeInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentYellow}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0" VerticalAlignment="Center" RenderOptions.ClearTypeHint="Enabled"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentYellow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filee Yellow Switch -->
        <Style x:Key="YellowSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="46" Height="26" CornerRadius="13" Background="{DynamicResource BgPill}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                            <Ellipse x:Name="thumb" Width="18" Height="18" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{DynamicResource TextSecondary}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentYellow}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentYellow}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="thumb" Property="Fill" Value="{DynamicResource AccentYellowFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Themed ComboBox Item -->
        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgPillHover}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgPillHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Themed ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="toggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          Cursor="Hand"
                                          Background="{DynamicResource BgInput}"
                                          BorderBrush="{DynamicResource BorderStrong}"
                                          BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Data="M 4,7 L 9,12 L 14,7"
                                                      Width="18" Height="18"
                                                      Stroke="{DynamicResource TextSecondary}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgPill}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentYellow}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentYellow}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="contentPresenter"
                                              IsHitTestVisible="False"
                                              Margin="12,0,34,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{DynamicResource TextPrimary}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border x:Name="dropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240"
                                        Margin="0,4,0,0"
                                        Padding="5"
                                        CornerRadius="12"
                                        Background="{DynamicResource BgCard}"
                                        BorderBrush="{DynamicResource BorderStrong}"
                                        BorderThickness="1.25">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="OuterMarginGrid" Margin="10">
        <!-- Shadow Layer (Active in both Main and Mini Oval Modes) -->
        <Border x:Name="ShadowLayer" Background="{DynamicResource BgMain}" CornerRadius="18" Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.58" Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- Main Shell -->
        <Border x:Name="RootShell"
                Background="{DynamicResource BgMain}"
                BorderBrush="{DynamicResource BorderStrong}"
                BorderThickness="1"
                CornerRadius="18"
                RenderOptions.ClearTypeHint="Enabled"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <Grid x:Name="InnerClipGrid" SizeChanged="InnerClipGrid_SizeChanged" RenderOptions.ClearTypeHint="Enabled">
                <!-- ========================================================= -->
                <!-- 1. MAIN FILEE-STYLE WORKSPACE                             -->
                <!-- ========================================================= -->
                <Grid x:Name="MainView" RenderOptions.ClearTypeHint="Enabled">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="215"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Sidebar -->
                    <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="14,26,14,16" RenderOptions.ClearTypeHint="Enabled">
                        <DockPanel LastChildFill="True">
                            <!-- Brand Block -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,20" Background="Transparent" MouseLeftButtonDown="DragWindow_MouseDown">
                                <Border Width="40" Height="40" CornerRadius="11" Background="#1A1B20" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" Padding="4" Margin="0,0,10,0">
                                    <Image Source="pack://application:,,,/Assets/Icons/brand.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="QBLauncher Pro" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Hızlı seç, anında aç." FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Sidebar Footer -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,0,0,10"/>
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="11" Padding="11,9" Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="SidebarStatusDot" Width="9" Height="9" Fill="{DynamicResource WarningColor}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        <StackPanel>
                                            <TextBlock x:Name="SidebarStatusTitle" Text="Onay Bekleniyor" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock x:Name="SidebarHotkeyLabel" Text="Alt + Space" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="7"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource PillBtn}" Padding="6,7" FontSize="13" Click="SwitchToMini_Click" Content="⚡ Mini Ekran"/>
                                    <Button Grid.Column="2" Style="{StaticResource PillBtn}" Padding="6,7" FontSize="13" Click="HideToBackground_Click" Content="Gizle"/>
                                </Grid>

                                <TextBlock Text="Sürüm 1.0.0" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,0"/>
                            </StackPanel>

                            <!-- Navigation Items -->
                            <StackPanel VerticalAlignment="Top">
                                <Button x:Name="NavHome" Style="{StaticResource NavBtn}" Tag="home" Click="NavTab_Click" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/Icons/nav_home.png" Width="21" Height="21" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                        <TextBlock Text="Ana sayfa" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavGeneral" Style="{StaticResource NavBtn}" Tag="general" Click="NavTab_Click" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/Icons/nav_general.png" Width="21" Height="21" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                        <TextBlock Text="Genel" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavHotkeys" Style="{StaticResource NavBtn}" Tag="hotkeys" Click="NavTab_Click" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/Icons/nav_hotkeys.png" Width="21" Height="21" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                        <TextBlock Text="Kısayollar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavPicker" Style="{StaticResource NavBtn}" Tag="picker" Click="NavTab_Click" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/Icons/nav_picker.png" Width="21" Height="21" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                        <TextBlock Text="Seçme ekranı" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavPresets" Style="{StaticResource NavBtn}" Tag="presets" Click="NavTab_Click" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/Icons/nav_presets.png" Width="21" Height="21" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                        <TextBlock Text="Ön ayarlar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavTheme" Style="{StaticResource NavBtn}" Tag="theme" Click="NavTab_Click" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/Icons/nav_theme.png" Width="21" Height="21" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                        <TextBlock Text="Tema" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
