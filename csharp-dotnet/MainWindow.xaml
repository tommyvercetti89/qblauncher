                                        <DockPanel Margin="0,0,0,14">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="GenStyleSquareBtn" Style="{StaticResource PillBtn}" Tag="square" Click="SelectLauncherStyle_Click" Padding="13,7" FontSize="13" Content="Kare Izgara (Buğulu Cam)" Margin="0,0,8,0"/>
