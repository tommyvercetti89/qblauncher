                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource PillBtn}" Padding="12,5" FontSize="13" Content="Çalıştır" Click="InlineTest_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource PillBtn}" Padding="10,5" FontSize="13" Content="↑" Click="InlineUp_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource PillBtn}" Padding="10,5" FontSize="13" Content="↓" Click="InlineDown_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource PillBtn}" Padding="12,5" FontSize="13" Foreground="{DynamicResource DangerColor}" Content="Kaldır" Click="InlineDelete_Click"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Ad" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                                        <TextBox x:Name="EdName" Style="{StaticResource LargeInput}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Alt Başlık" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                                        <TextBox x:Name="EdSubtitle" Style="{StaticResource LargeInput}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Hedef Yol, Komut veya Web Adresi" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="EdTarget" Style="{StaticResource LargeInput}" Margin="0,0,0,10"/>
                                                <UniformGrid Columns="3" Height="36">
                                                    <Button Style="{StaticResource PillBtn}" Padding="8,0" FontSize="13" Content="Dosya Seç" Click="InlinePickFile_Click" Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource PillBtn}" Padding="8,0" FontSize="13" Content="Klasör Seç" Click="InlinePickFolder_Click" Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource YellowPillBtn}" Padding="8,0" FontSize="13" Content="Kaydet" Click="InlineSave_Click"/>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- COL 3: Kullanılabilir ön ayarlar -->
                                <DockPanel Grid.Column="4" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Text="Kullanılabilir ön ayarlar" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>

                                    <UniformGrid DockPanel.Dock="Top" Columns="3" Height="34" Margin="0,0,0,8">
                                        <Button Style="{StaticResource PillBtn}" Padding="4,0" FontSize="12" Content="+ Yeni Öğe" Click="OpenAddModal_Click" Margin="0,0,5,0"/>
