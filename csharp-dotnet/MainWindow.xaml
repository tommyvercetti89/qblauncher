                                        <TextBlock x:Name="TopHotkeyPill" Text="Alt + Space • Beklemede" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PillBtn}" Padding="12,5" FontSize="13" Content="Arka Plana Gizle" Click="HideToBackground_Click" ToolTip="Pencereyi gizle ve arka planda dinlemeye devam et" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource WinIconBtn}" Click="QuickTheme_Click" ToolTip="Temayı Değiştir" Margin="0,0,4,0">
                                        <Path Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" Width="16" Height="16" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource WinIconBtn}" Click="Minimize_Click" ToolTip="Küçült" Margin="0,0,4,0">
                                        <Path Data="M5 12H19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" Width="15" Height="15" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource WinIconBtn}" Click="ToggleMaximize_Click" ToolTip="Büyüt / Tam Ekran" Margin="0,0,4,0">
                                        <Path Data="M5 5H19V19H5V5Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" Width="14" Height="14" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource WinIconBtn}" Click="Quit_Click" ToolTip="Uygulamayı Tamamen Kapat">
                                        <Path Data="M18 6L6 18M6 6L18 18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" Width="15" Height="15" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Consent Banner -->
                        <Border x:Name="ConsentBanner" DockPanel.Dock="Top" Margin="22,12,22,0" Padding="15,11" CornerRadius="14" Background="{DynamicResource NavActiveBg}" BorderBrush="{DynamicResource AccentYellow}" BorderThickness="1">
