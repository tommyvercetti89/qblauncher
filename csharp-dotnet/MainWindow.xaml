                                        <StackPanel>
                                            <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource NavActiveBg}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                                <TextBlock Text="2" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource NavActiveFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Kısayolunuzu Seçin" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                                            <TextBlock Text="Kısayollar bölümünden dinleyiciyi aktif edin ve dilediğiniz tuş kombinasyonunu (örneğin Alt + Space) belirleyin." FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16">
                                        <StackPanel>
                                            <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource NavActiveBg}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                                <TextBlock Text="3" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource NavActiveFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Anında Başlatın" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                                            <TextBlock Text="Bilgisayarınızda hangi ekranda olursanız olun kısayolunuza basın; açılan mini ekrandan tıklayarak veya 1–9 tuşlarıyla anında açın." FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Keyboard Shortcuts Guide: 2x2 Symmetrical Grid -->
                                <TextBlock Text="Klavye Kısayolları Rehberi" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="2" Margin="0,0,0,14">
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,10,10">
                                        <StackPanel>
                                            <TextBlock Text="Seçilen Kısayol (Alt + Space)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentYellow}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Mini seçme ekranını her yerden anında açar veya gizler." FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="1 – 9 Rakam Tuşları" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentYellow}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Mini ekrandaki ilgili sıradaki uygulamayı fareye dokunmadan başlatır." FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Ok Tuşları ve Enter" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentYellow}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Mini ekranda klavyeyle gezinip seçili öğeyi çalıştırır." FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="F1 ve Esc Tuşları" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentYellow}" Margin="0,0,0,4"/>
                                            <TextBlock Text="F1 ana yönetim ekranına geçirir, Esc mini ekranı arka plana gizler." FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Credits & Design Inspiration: 2 Symmetrical Info Boxes -->
                                <UniformGrid Columns="2">
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Geliştirici Bilgisi" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Bu yazılım tommyvercetti89 tarafından Antigravity ile geliştirilmiştir." FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Tasarım İlhamı" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Filee arayüzünden esinlenilmiştir." FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- ========================================================= -->
                <!-- 2. ADD / EDIT ITEM MODAL                                  -->
                <!-- ========================================================= -->
                <Grid x:Name="ItemModalOverlay" Visibility="Collapsed" Background="#90000000">
                    <Border Width="580" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
                        </Border.Effect>
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,15">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource WinIconBtn}" Click="CloseModal_Click">
                                        <Path Data="M18 6L6 18M6 6L18 18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Width="15" Height="15" Stretch="Uniform"/>
                                    </Button>
                                    <TextBlock x:Name="ModalTitleText" Text="Yeni Öğe Ekle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,14">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PillBtn}" Content="İptal" Click="CloseModal_Click" Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource YellowPillBtn}" Content="Kaydet" Click="SaveModal_Click"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="20,18">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Görünen Ad" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="InpName" Style="{StaticResource LargeInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Alt Başlık" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="InpSubtitle" Style="{StaticResource LargeInput}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Kategori" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="InpCategory" Style="{StaticResource ModernComboBox}" ItemContainerStyle="{StaticResource ModernComboBoxItem}">
                                            <ComboBoxItem Content="Uygulama (.exe)" Tag="app"/>
                                            <ComboBoxItem Content="Dosya veya Klasör" Tag="file"/>
                                            <ComboBoxItem Content="Web Sitesi (URL)" Tag="web"/>
                                            <ComboBoxItem Content="PowerShell / Sistem" Tag="system"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Özel İkon" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="InpIcon" Style="{StaticResource ModernComboBox}" ItemContainerStyle="{StaticResource ModernComboBoxItem}">
                                            <ComboBoxItem Content="Antigravity (Özel)" Tag="antigravity"/>
                                            <ComboBoxItem Content="PowerShell Kabuğu" Tag="powershell"/>
                                            <ComboBoxItem Content="Terminal / CMD" Tag="terminal"/>
                                            <ComboBoxItem Content="Masaüstü Uygulaması" Tag="app"/>
                                            <ComboBoxItem Content="Klasör" Tag="folder"/>
                                            <ComboBoxItem Content="Belge / Dosya" Tag="file"/>
                                            <ComboBoxItem Content="Web / Tarayıcı" Tag="globe"/>
                                            <ComboBoxItem Content="Sistem / İşlemci" Tag="cpu"/>
                                            <ComboBoxItem Content="Araçlar" Tag="calculator"/>
                                            <ComboBoxItem Content="Hızlı Komut" Tag="bolt"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Hedef Yol, Komut veya URL" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="7"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="7"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="InpTarget" Grid.Column="0" Style="{StaticResource LargeInput}"/>
                                        <Button Grid.Column="2" Style="{StaticResource PillBtn}" Content="Dosya Seç" Click="PickFile_Click"/>
                                        <Button Grid.Column="4" Style="{StaticResource PillBtn}" Content="Klasör Seç" Click="PickFolder_Click"/>
                                    </Grid>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Başlatma Argümanları (Opsiyonel)" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="InpArgs" Style="{StaticResource LargeInput}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="10" Height="38" Padding="12,0" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="InpAdmin" Style="{StaticResource YellowSwitch}"/>
                                            <TextBlock Text="Yönetici olarak çalıştır" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Toast Pill -->
                <Border x:Name="ToastBorder" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Padding="18,11" CornerRadius="10" Background="{DynamicResource AccentYellow}">
                    <TextBlock x:Name="ToastText" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentYellowFg}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
