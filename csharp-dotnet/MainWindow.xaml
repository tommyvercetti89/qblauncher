                                        <StackPanel x:Name="ProfileListStack"/>
                                    </ScrollViewer>
                                </DockPanel>

                                <!-- COL 2: 2. Mini seçme ekranını düzenleyin -->
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="2. Mini seçme ekranını düzenleyin" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>

                                        <!-- Center Stage Card -->
                                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="18" Padding="18,16" Margin="0,0,0,14">
                                            <StackPanel>
                                                <Border Background="{DynamicResource BgPill}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <UniformGrid Columns="2" Width="330" Height="32">
                                                        <Button x:Name="SegSquareModeBtn" Style="{StaticResource SegPillBtn}" Tag="square" Click="SelectLauncherStyle_Click" Content="Kare Izgara Modu"/>
                                                        <Button x:Name="SegClassicModeBtn" Style="{StaticResource SegPillBtn}" Tag="classic" Click="SelectLauncherStyle_Click" Content="Klasik Mini Mod"/>
                                                    </UniformGrid>
                                                </Border>

                                                <TextBlock x:Name="StageCaptionText" Text="Buğulu cam üzerinde kare ızgara • Düzenlemek için kutuya tıklayın" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                                                <Border Background="{DynamicResource BgStageInner}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,0,14">
                                                    <UniformGrid x:Name="StagePreviewGrid" Columns="3"/>
                                                </Border>

                                                <Button Style="{StaticResource PillBtn}" HorizontalAlignment="Center" Padding="20,8" Click="SwitchToMini_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentYellow}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Canlı Test Et — Seçme Ekranını Aç"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Inline Item Editor Card -->
                                        <Border x:Name="InlineEditorCard" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="18,15">
