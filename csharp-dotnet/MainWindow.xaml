                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource AccentYellow}" CornerRadius="8" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Onay Gerekli" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentYellowFg}"/>
                                </Border>
                                <TextBlock x:Name="ConsentBannerDesc" Grid.Column="1" Text="Uygulama siz kapatana kadar kısayol tuşunu süresiz dinlesin ve Mini Seçme Ekranını açsın mı?" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
