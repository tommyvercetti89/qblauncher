                                        <TextBlock Text="Hakkında" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Main Workspace -->
                    <DockPanel Grid.Column="1" LastChildFill="True">
                        <!-- Top Drag Bar (Pinned Right Controls via 3-Column Grid) -->
                        <Border DockPanel.Dock="Top" Height="58" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="26,12,18,4" Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
