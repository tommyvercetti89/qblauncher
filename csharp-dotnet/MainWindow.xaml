                                        <WrapPanel Margin="0,0,0,14">
                                            <Border x:Name="HotkeyDisplayBorder" MinWidth="200" Height="44" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="12" Padding="18,0" Margin="0,0,12,8">
                                                <TextBlock x:Name="HotkeyDisplayText" Text="Alt + Space" FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
