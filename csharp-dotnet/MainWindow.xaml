                                            <CheckBox x:Name="ChkRunOnStartup" DockPanel.Dock="Right" Style="{StaticResource YellowSwitch}" Checked="BehaviorToggle_Changed" Unchecked="BehaviorToggle_Changed"/>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="Bilgisayar Açıldığında Otomatik Başlat" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                                <TextBlock Text="Windows oturumu açıldığında QBLauncher Pro arka planda sessizce başlatılır ve kısayolunuzu dinlemeye devam eder." FontSize="14" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="20">
